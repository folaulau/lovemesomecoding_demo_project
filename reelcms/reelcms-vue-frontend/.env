# false = talk to the Spring Boot API. Set to true to run the whole UI with no
# backend at all, against src/api/mock.js.
#
# Vite reads .env at STARTUP only - changing this needs a dev-server restart, not
# just a page reload. The badge in the admin header shows which mode is live.
VITE_USE_MOCK=false
VITE_API_BASE=http://localhost:8087
