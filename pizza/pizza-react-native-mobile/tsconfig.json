{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,

    /*
     * Extra strictness beyond `strict`. `noUncheckedIndexedAccess` is the one that earns its
     * keep here: it makes `products[0]` typed `Product | undefined`, which is the truth — an
     * empty menu is a real state this app has to render.
     */
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,

    /*
     * Path aliases, so a screen imports `@/features/cart` rather than `../../../features/cart`.
     * Metro reads these from tsconfig automatically (via `expo/metro-config`), so there is no
     * second copy of this mapping to keep in sync.
     *
     * No `baseUrl`: TypeScript 6 deprecated it, and paths resolved relative to this file work in
     * both TypeScript and Metro without it.
     */
    "paths": {
      "@/*": ["./src/*"]
    },

    /*
     * Jest's globals (`describe`, `it`, `jest`) are ambient declarations. Naming the package here
     * is what puts them in scope for jest.setup.ts and every *.test.tsx — without it `tsc` reports
     * "Cannot use namespace 'jest' as a value" in files that run perfectly well.
     */
    "types": ["jest"]
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules", "e2e"]
}
