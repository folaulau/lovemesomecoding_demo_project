{
  "name": "pizza-react-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:e2e": "playwright test e2e/browse.spec.ts e2e/cart.spec.ts e2e/auth.spec.ts e2e/checkout.spec.ts e2e/orders-and-misc.spec.ts e2e/profile.spec.ts e2e/api-guards.spec.ts",
    "screenshots": "playwright test e2e/screenshots.spec.ts e2e/admin-screens.spec.ts",
    "typecheck": "tsc -b --noEmit",
    "test:payment": "playwright test e2e/payment.spec.ts",
    "test:admin": "playwright test e2e/admin.spec.ts",
    "test:all": "playwright test --grep-invert \"capture the\""
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "@stripe/react-stripe-js": "^6.8.1",
    "@stripe/stripe-js": "^9.13.0",
    "bootstrap": "^5.3.8",
    "react": "^19.2.8",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.8",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "sass": "^1.102.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
