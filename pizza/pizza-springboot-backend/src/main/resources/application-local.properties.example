# Copy to application-local.properties (which is gitignored) and fill in.
# Run with: ./mvnw spring-boot:run -Dspring-boot.run.profiles=local
#
# Get test keys from https://dashboard.stripe.com/test/apikeys
# The secret key must never reach the frontend or a commit.

pizza.stripe.secret-key=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
pizza.stripe.publishable-key=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# From `stripe listen --forward-to localhost:8080/api/webhooks/stripe`
pizza.stripe.webhook-secret=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

pizza.jwt.secret=replace-with-a-long-random-string-at-least-32-characters
