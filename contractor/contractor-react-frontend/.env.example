# Frontend configuration. Copy to `.env.local` to override.
#
# ⚠️ Only variables prefixed VITE_ reach the bundle, and everything that does is PUBLIC — readable
# by anyone who opens devtools. Never put a secret here, and never put the Hasura admin secret
# anywhere near this app.

# NestJS. Every create, update and delete.
VITE_API_URL=http://localhost:3001

# Hasura. Every read.
VITE_GRAPHQL_URL=http://localhost:8083/v1/graphql
