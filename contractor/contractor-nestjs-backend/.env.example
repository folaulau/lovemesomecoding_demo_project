# Backend configuration. Copy to `.env` to override — every value below is also the DEFAULT in
# src/config/configuration.ts, so a fresh clone runs with no .env file at all.

CONTRACTOR_PORT=3001

# ⚠️ 5434 is the HOST port. Inside the compose network Postgres is on 5432 — the shift is a
# published-port mapping only, and using 5434 from inside a container is a classic failure.
CONTRACTOR_DB_HOST=localhost
CONTRACTOR_DB_PORT=5434
CONTRACTOR_DB_USER=contractor
CONTRACTOR_DB_PASSWORD=contractor
CONTRACTOR_DB_NAME=contractor

# ⚠️ MUST match HASURA_GRAPHQL_JWT_SECRET.key in ../docker-compose.yml exactly. NestJS signs with
# it, Hasura verifies with it. A mismatch does not fail at startup — every GraphQL request just
# returns "Could not verify JWT: JWSInvalidSignature", which reads like a client bug and is not.
CONTRACTOR_JWT_SECRET=contractor-dev-jwt-secret-change-me-in-production-0123456789
CONTRACTOR_JWT_EXPIRES_IN=7d

CONTRACTOR_UPLOAD_DIR=uploads
CONTRACTOR_UPLOAD_MAX_BYTES=5242880

# ⚠️ An explicit allowlist, never a wildcard. The Vite dev server owns 5177 and `strictPort` keeps
# it there; any other origin fails CORS, and the symptom is a blank page rather than a clear error.
CONTRACTOR_CORS_ORIGINS=http://localhost:5177
