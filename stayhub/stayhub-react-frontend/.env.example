# Copy to .env.local (gitignored).

VITE_API_URL=http://localhost:8000/api/v1
VITE_HASURA_URL=http://localhost:8081/v1/graphql

# Stripe's PUBLISHABLE key is public by design — it identifies the account and can only create
# payment attempts, never move money. The SECRET key belongs in the backend .env and nowhere else.
VITE_STRIPE_PUBLISHABLE_KEY=
