# Copy to .env and fill in. .env is gitignored — never commit a real secret key.

STAYHUB_DATABASE_URL=postgresql+psycopg://stayhub:stayhub@localhost:5433/stayhub

# MUST match HASURA_GRAPHQL_JWT_SECRET's `key` in docker-compose.yml, or Hasura rejects
# every token FastAPI signs with "Malformed Authorization header" / signature errors.
STAYHUB_JWT_SECRET=dev-only-change-me-in-any-real-deployment-0123456789

STAYHUB_ELASTICSEARCH_URL=http://localhost:9200

# Stripe TEST mode. The publishable key is public by design and lives in the frontends' .env.local;
# the secret key lives here and nowhere else.
STAYHUB_STRIPE_SECRET_KEY=
STAYHUB_STRIPE_WEBHOOK_SECRET=
